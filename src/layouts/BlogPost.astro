---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ColorScript from "../components/ColorScript.astro";
import Tags from "../components/Tags.astro";
import getTags from "../scripts/getTags";

const posts = await getCollection("posts");
const allTags = getTags(posts);

let {
	content: { title, description, added, updated, tags, heroImage },
} = Astro.props;

added = added && added !== "nodate" ? new Date(added).toLocaleDateString(
	"en-us",
	{
		year: "numeric",
		month: "short",
		day: "numeric",
	}
) : null;

if (updated) {
	updated = new Date(updated).toLocaleDateString(
		"en-us",
		{
			year: "numeric",
			month: "short",
			day: "numeric",
		}
	);
}
---

<html lang="en-us">
	<BaseHead title={title} description={description} />

	<body>
		<Header />
		<main class="subpage-main">
			<article>
				{heroImage && <img width={720} height={360} src={heroImage} alt="" />}
				<h1 class="article-title">{title}</h1>
				{updated ?
					<span><time>{added}</time>, last updated on <time>{updated}</time></span>
					:
					<span>{added && <time>{added}</time>}</span>
				}
				<Tags tags={tags} />
				<hr />
				<div class="blog-post">
					<slot />
				</div>
				<footer class="post-footer" aria-label="End of post">
					<img src="/logos/coffee.png" alt="" loading="lazy" />
				</footer>
			</article>
		</main>
		<Tags tags={allTags} all />
		<Footer />
		<ColorScript />
	</body>
</html>

<style>
	.post-footer {
		display: flex;
		justify-content: center;
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px dashed var(--moretranswhite);
	}

	.post-footer img {
		width: 56px;
		height: 56px;
		object-fit: contain;
	}
</style>
